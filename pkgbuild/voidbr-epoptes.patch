+# VoidBR patch: uma sessao do Observar/Assistir no KDE, do comeco ao fim.
+# Parameters: $1 = host:port, $2 = viewonly ou assist, $3 = senha.
+kde_vnc_session() {
+    local target="$1" mode="$2" pwd="$3" dir cfgdir port kpid tentativa
+    local autorizado=""
+
+    dir=$(wayland_state_dir)
+    cfgdir="$dir/krfb-config"
