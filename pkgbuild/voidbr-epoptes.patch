+#!/bin/sh
+# -*- coding: utf-8 -*-
+#
+#  broadcast-wayland — VoidBR: "Transmitir tela" com o servidor (professor)
+#                      numa sessao Wayland
+#  Created: sex 27 nov 2026 19:11:18 -04
+#  Updated: sex 27 nov 2026 19:11:18 -04
+#
+#  Copyright (c) 2026, Vilmar Catafesta <vcatafesta@gmail.com>
+#  SPDX-License-Identifier: GPL-3.0-or-later
+#
+# No X11 o Epoptes transmite a tela do professor com o x11vnc, que le a tela
+# do X. No Wayland nao ha tela do X para ler, entao este script:
+#   1. sobe um servidor VNC local, so de visualizacao, que le a tela Wayland:
+#      - GNOME: o do proprio GNOME (gnome-remote-desktop), com uma senha
+#        descartavel na colecao "session" do chaveiro;
+#      - Hyprland, Sway e outros wlroots: o wayvnc, so em 127.0.0.1;
+#   2. sobe o x11vnc -reflect, que se conecta a esse servidor e repassa a tela
+#      aos alunos na porta e com a senha de sempre do Epoptes. O servidor do
+#      GNOME so aceita um visualizador por vez; o x11vnc e esse unico
+#      visualizador e atende a turma toda.
+# Assim os clientes nao mudam nada: recebem o mesmo "receive_broadcast".
+#
+# Uso: broadcast-wayland <porta> <arquivo de senha do x11vnc>
+# Termina (e desfaz tudo) com SIGTERM, ou quando o x11vnc sair.
+
+_VERSION_="1.0.0-20261127"
+
+porta=$1
+senhas=$2
+dir=${XDG_RUNTIME_DIR:-/tmp}/epoptes-broadcast-$(id -u)
+schema=org.gnome.desktop.remote-desktop.vnc
+xdg=org.gnome.RemoteDesktop.VncCredentials
+colecao=/org/freedesktop/secrets/collection/session
+fonte=
+xpid=
+gpid=
+
+erro() {
+    echo "$*" >&2
+    limpa
+    exit 1
+}
+
+# Porta livre em 127.0.0.1 para o servidor VNC local.
+porta_livre() {
+    python3 -c '
+import socket
+s = socket.socket()
+s.bind(("127.0.0.1", 0))
+print(s.getsockname()[1])
+s.close()
+' 2>/dev/null
+}
+
+# Espera ate 10 s alguem escutar na porta $1 (e o processo $2 continuar vivo).
+espera_porta() {
+    local tentativa=0
+
+    while [ "$tentativa" -lt 50 ]; do
+        ss -Hltn "sport = :$1" 2>/dev/null | grep -q . && return 0
+        kill -0 "$2" 2>/dev/null || return 1
+        tentativa=$((tentativa + 1))
+        sleep 0.2
+    done
+    return 1
+}
+
+grd_daemon() {
+    local f
+
+    for f in /usr/libexec/gnome-remote-desktop-daemon \
+        /usr/lib/gnome-remote-desktop-daemon \
+        /usr/lib/gnome-remote-desktop/gnome-remote-desktop-daemon; do
+        if [ -x "$f" ]; then
+            echo "$f"
+            return 0
+        fi
+    done
+    return 1
+}
+
+limpa() {
+    local k v
+
+    test -n "$xpid" && kill "$xpid" 2>/dev/null
+    test -n "$gpid" && kill "$gpid" 2>/dev/null
+    wait 2>/dev/null
+    xpid=
+    gpid=
+    if [ "$fonte" = gnome ]; then
+        if [ -s "$dir/grd-settings" ]; then
+            while read -r k v; do
+                gsettings set "$schema" "$k" "$v"
+            done <"$dir/grd-settings"
+        fi
+        timeout 30 secret-tool clear xdg:schema "$xdg" epoptes broadcast
+    fi
+    fonte=
+    rm -rf "$dir"
+}
+
+trap 'limpa; exit 0' INT TERM HUP
+
+test -n "$porta" && test -s "$senhas" ||
+    erro "uso: broadcast-wayland <porta> <arquivo de senha do x11vnc>"
+test -n "$WAYLAND_DISPLAY" || erro "a sessao do professor nao e Wayland"
+command -v x11vnc >/dev/null 2>&1 || erro "falta o pacote x11vnc no servidor"
+rm -rf "$dir"
+mkdir -p -m 700 "$dir" || erro "nao consegui criar $dir"
+lporta=$(porta_livre)
+test -n "$lporta" || erro "nao consegui escolher uma porta livre"
+
+case ":${XDG_CURRENT_DESKTOP}:" in
+*:GNOME:*)
+    fonte=gnome
+    grd=$(grd_daemon) ||
+        erro "falta o pacote gnome-remote-desktop no servidor (a transmissao no GNOME usa o servidor VNC do proprio GNOME)"
+    command -v secret-tool >/dev/null 2>&1 ||
+        erro "falta o secret-tool (pacote libsecret) no servidor"
+    if pgrep -u "$(id -u)" -f gnome-remote-desktop-daemon >/dev/null; then
+        fonte=
+        erro "o compartilhamento de tela do GNOME ja esta ligado nesta sessao; desligue-o em Configuracoes > Sistema > Area de trabalho remota e tente de novo"
+    fi
+    # Senha descartavel entre o servidor do GNOME e o x11vnc (8 letras: o
+    # limite da senha VNC).
+    senha=$(tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 8)
+    for k in enable auth-method view-only; do
+        echo "$k $(gsettings get "$schema" "$k")"
+    done >"$dir/grd-settings"
+    # O servidor do GNOME guarda a senha como GVariant de string: 'senha'.
+    # Na colecao "session" do chaveiro (so na memoria, sempre destrancada)
+    # nao aparece pedido de senha do chaveiro.
+    printf "'%s'" "$senha" | timeout 60 secret-tool store \
+        --collection="$colecao" --label='GNOME Remote Desktop VNC password' \
+        xdg:schema "$xdg" epoptes broadcast ||
+        erro "nao consegui gravar a senha no chaveiro do GNOME (gnome-keyring rodando?)"
+    gsettings set "$schema" auth-method "'password'"
+    gsettings set "$schema" view-only true
+    gsettings set "$schema" enable true
+    "$grd" --vnc-port "$lporta" >"$dir/grd.log" 2>&1 &
+    gpid=$!
+    espera_porta "$lporta" "$gpid" ||
+        erro "o gnome-remote-desktop nao subiu: $(tail -n 5 "$dir/grd.log" 2>/dev/null)"
+    X11VNC_REFLECT_PASSWORD=$senha
+    export X11VNC_REFLECT_PASSWORD
+    ;;
+*)
+    fonte=wayvnc
+    command -v wayvnc >/dev/null 2>&1 ||
+        erro "falta o pacote wayvnc no servidor (a transmissao em Hyprland, Sway e outros wlroots usa o wayvnc)"
+    # Config vazia (ignora a ~/.config/wayvnc/config do professor), socket de
+    # controle proprio (nao briga com outro wayvnc), sem entrada (-d) e so em
+    # 127.0.0.1: so o x11vnc daqui se conecta.
+    : >"$dir/wayvnc.config"
+    wayvnc -C "$dir/wayvnc.config" -S "$dir/wayvncctl" -d \
+        127.0.0.1 "$lporta" >"$dir/wayvnc.log" 2>&1 &
+    gpid=$!
+    espera_porta "$lporta" "$gpid" ||
+        erro "o wayvnc nao subiu (o compositor e wlroots?): $(tail -n 5 "$dir/wayvnc.log" 2>/dev/null)"
+    unset X11VNC_REFLECT_PASSWORD
+    ;;
+esac
+
+# O x11vnc repassa a tela aos alunos, com a senha do Epoptes, como no X11.
+x11vnc -reflect "127.0.0.1:$lporta" -forever -shared -viewonly -nopw -quiet \
+    -nolookup -rfbauth "$senhas" -rfbport "$porta" >"$dir/x11vnc.log" 2>&1 &
+xpid=$!
+espera_porta "$porta" "$xpid" ||
+    erro "o x11vnc -reflect nao subiu: $(tail -n 5 "$dir/x11vnc.log" 2>/dev/null)"
+echo "transmitindo pela porta $porta (fonte: $fonte)"
+
+# Fica ate o servidor do Epoptes mandar parar (SIGTERM) ou o x11vnc sair.
+while kill -0 "$xpid" 2>/dev/null; do
+    sleep 1
+done
+limpa
