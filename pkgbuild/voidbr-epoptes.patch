+    @staticmethod
+    def render_markdown(buf, texto):
+        """Insert a small subset of Markdown into a Gtk.TextBuffer: titles,
+        lists, tables, indented commands and **bold**."""
+        def inserir(linha, *tags):
+            # **negrito** dentro da linha
+            partes = re.split(r'\*\*(.+?)\*\*', linha)
+            for i, parte in enumerate(partes):
+                if not parte:
+                    continue
+                extra = ('negrito',) if i % 2 else ()
+                buf.insert_with_tags_by_name(
+                    buf.get_end_iter(), parte, *(tags + extra))
+            buf.insert(buf.get_end_iter(), '\n')
+
+        linhas = texto.split('\n')
+        i = 0
+        while i < len(linhas):
+            linha = linhas[i]
+            if linha.startswith('|'):
+                # Tabela: alinha as colunas em fonte fixa
+                bloco = []
+                while i < len(linhas) and linhas[i].startswith('|'):
+                    celulas = [c.strip() for c in
+                               linhas[i].strip().strip('|').split('|')]
+                    if not all(re.match(r'^:?-+:?$', c) for c in celulas):
+                        bloco.append([c.replace('**', '') for c in celulas])
+                    i += 1
+                larguras = [max(len(lin[c]) if c < len(lin) else 0
+                                for lin in bloco)
+                            for c in range(max(len(lin) for lin in bloco))]
+                for n, lin in enumerate(bloco):
+                    texto_lin = '  '.join(
+                        (lin[c] if c < len(lin) else '').ljust(larguras[c])
+                        for c in range(len(larguras))).rstrip()
+                    buf.insert_with_tags_by_name(
+                        buf.get_end_iter(), texto_lin + '\n',
+                        'cabecalho' if n == 0 else 'tabela')
+                buf.insert(buf.get_end_iter(), '\n')
+                continue
+            if linha.startswith('### '):
+                inserir(linha[4:], 'h3')
+            elif linha.startswith('## '):
+                inserir(linha[3:], 'h2')
+            elif linha.startswith('# '):
+                inserir(linha[2:], 'h1')
+            elif re.match(r'^ {4,}\S', linha):
+                inserir(linha.strip(), 'codigo')
+            elif linha.startswith('- '):
+                inserir('\u2022 ' + linha[2:], 'item')
+            else:
+                inserir(linha)
+            i += 1
+
