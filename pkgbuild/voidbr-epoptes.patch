+    kpid=$!
+    xprop_set EPOPTES_KRFB_PID "$kpid"
+    # Espera ate 20 s o krfb comecar a escutar (conversa com o portal antes).
+    tentativa=0
+    while [ "$tentativa" -lt 100 ] && kill -0 "$kpid" 2>/dev/null &&
+        ! ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; do
+        tentativa=$((tentativa + 1))
+        sleep 0.2
+    done
+    if kill -0 "$kpid" 2>/dev/null &&
+        ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; then
+        # Termina quando o servidor do Epoptes fecha o visualizador, quando o
+        # aluno para o compartilhamento, ou no stop_receptions.
+        socat "TCP:$target" "TCP:127.0.0.1:$port"
+    else
+        echo "kde_vnc_session: o krfb nao subiu, veja $dir/krfb.log" >&5
+    fi
+
