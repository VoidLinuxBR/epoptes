+import socket
+s = socket.socket()
+s.bind(("127.0.0.1", 0))
+print(s.getsockname()[1])
+s.close()
+' 2>/dev/null)
+    if [ -z "$port" ]; then
+        echo "kde_vnc_session: nao consegui escolher uma porta livre" >&5
+        return 1
