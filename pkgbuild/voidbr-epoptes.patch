+            return icones
+        for obj in objetos:
+            if obj.get('class') != 'GtkImage' or not obj.get('id'):
+                continue
+            img = self.get(obj.get('id'))
+            props = {x.get('name'): x.text for x in obj.findall('property')}
+            if img is None or not props.get('pixbuf') or not img.get_pixbuf():
+                continue
+            arq = props['pixbuf']
+            if not arq.endswith('.svg'):
+                svg = os.path.join('images', os.path.splitext(
+                    os.path.basename(arq))[0] + '.svg')
