+# VoidBR patch: usuarios com sessao grafica aberta nesta maquina, separados
+# por virgula. So na conexao do root (precisa ler o environ de todos os
+# processos). Conta quem tem processo com DISPLAY/WAYLAND_DISPLAY e uid de
+# usuario comum (>= UID_MIN), o que deixa de fora o greeter (sddm, gdm...).
+graphical_users() {
+    test "$UID" -eq 0 || return 0
+    graphical_users_list | paste -sd ',' -
+}
+
+# VoidBR patch: um usuario por linha (ver graphical_users). Mesmo criterio do
+# vigia (session-watch) e do epoptes-client --check: um processo de uid comum
+# com WAYLAND_DISPLAY ou DISPLAY=:N no ambiente e o socket dessa tela ainda
+# existindo.
+graphical_users_list() {
+    local uid_min f pid uid vistos amb wd dp rt n
+
+    uid_min=$(awk '$1 == "UID_MIN" { print $2; exit }' /etc/login.defs 2>/dev/null)
+    uid_min=${uid_min:-1000}
+    vistos=" "
+    for f in $(grep -lsa 'DISPLAY=' /proc/[0-9]*/environ 2>/dev/null); do
+        pid=${f#/proc/}
+        pid=${pid%/environ}
+        uid=$(stat -c %u "/proc/$pid" 2>/dev/null) || continue
+        test "$uid" -ge "$uid_min" 2>/dev/null && test "$uid" -lt 65534 || continue
+        case "$vistos" in
+        *" $uid "*) continue ;;
+        esac
+        amb=$(tr '\0' '\n' 2>/dev/null <"$f") || continue
+        wd=$(echo "$amb" | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1)
+        dp=$(echo "$amb" | sed -n 's/^DISPLAY=//p' | head -n 1)
+        rt=$(echo "$amb" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n 1)
+        rt=${rt:-/run/user/$uid}
+        # O socket da tela tem que existir: um processo que sobrou de uma
+        # sessao que ja acabou (ou um ssh -X, DISPLAY=localhost:10) nao conta.
+        if [ -n "$wd" ]; then
+            case "$wd" in
+            /*) test -S "$wd" ;;
+            *) test -S "$rt/$wd" ;;
+            esac || continue
+        else
+            case "$dp" in
+            :*) ;;
+            *) continue ;;
+            esac
+            n=${dp#:}
+            n=${n%%.*}
+            test -S "/tmp/.X11-unix/X$n" || continue
+        fi
+        vistos="$vistos$uid "
+        stat -c %U "/proc/$pid" 2>/dev/null
+    done | sort -u
+}
+
+# VoidBR patch: "Diagnosticar cliente" da interface do servidor. Roda o
+# epoptes-client --check e devolve a saida. O stdin vai para /dev/null: o
+# stdin deste shell e a propria conexao com o servidor, e o openssl do
+# --check leria os proximos comandos dela.
+diagnose() {
+    local ec
+
+    ec=$(command -v epoptes-client 2>/dev/null)
+    test -n "$ec" || ec=/usr/sbin/epoptes-client
+    if ! grep -qs 'run_check' "$ec"; then
+        echo "  [FALHA] o epoptes-client desta maquina nao tem o --check"
+        echo "          -> atualize o pacote do cliente (voidbr-epoptes-client ou chili-epoptes-client)"
+        return 0
+    fi
+    if command -v timeout >/dev/null 2>&1; then
+        timeout 20 "$ec" --check </dev/null 2>&1
+    else
+        "$ec" --check </dev/null 2>&1
+    fi
+    return 0
+}
