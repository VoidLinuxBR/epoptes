+# VoidBR patch: uma sessao do Observar/Assistir no GNOME, do comeco ao fim.
+# Parameters: $1 = gnome-remote-desktop-daemon, $2 = host:port,
+# $3 = viewonly ou assist, $4 = senha.
+gnome_vnc_session() {
+    local grd="$1" target="$2" mode="$3" pwd="$4" schema xdg dir port gpid
+    local colecao tentativa k v
+
+    schema=org.gnome.desktop.remote-desktop.vnc
+    xdg=org.gnome.RemoteDesktop.VncCredentials
+    # A senha vai para a colecao "session" do gnome-keyring: fica so na
+    # memoria, esta sempre destrancada e some no logout. O chaveiro "login"
+    # nao e tocado, entao nao aparece pedido de senha nem com autologin
+    # (em que o "login" fica trancado, porque o PAM nao recebe senha).
+    colecao=/org/freedesktop/secrets/collection/session
+    dir=$(wayland_state_dir)
+    # Dois servidores do GNOME na mesma sessao disputam o mesmo nome no
+    # D-Bus; se o usuario ja ligou o compartilhamento de tela, desiste.
+    if pgrep -u "$UID" -f gnome-remote-desktop-daemon >/dev/null; then
+        echo "gnome_vnc_session: o compartilhamento de tela do GNOME ja esta ligado nesta sessao" >&5
+        return 1
+    fi
+    port=$(python3 -c '
+import socket
+s = socket.socket()
+s.bind(("127.0.0.1", 0))
+print(s.getsockname()[1])
+s.close()
+' 2>/dev/null)
+    if [ -z "$port" ]; then
+        echo "gnome_vnc_session: nao consegui escolher uma porta livre" >&5
+        return 1
+    fi
+
+    # A senha tem que ir para o gnome-keyring: e onde o servidor VNC do
+    # GNOME a procura. Se a carteira do KDE tomou o servico de senhas depois
+    # da conexao, devolve ao gnome-keyring antes.
+    ensure_gnome_keyring || return 1
+
+    # Guarda a configuracao que o usuario tinha, para devolver no fim.
+    for k in enable auth-method view-only; do
+        echo "$k $(gsettings get "$schema" "$k")"
+    done >"$dir/grd-settings"
+    # O gnome-remote-desktop guarda a senha como texto de um GVariant de
+    # string, ou seja, entre aspas simples: 'senha'. O atributo epoptes
+    # marca o item, para o clear do fim apagar so o nosso. O timeout evita
+    # ficar preso se o chaveiro nao responder.
+    if ! printf "'%s'" "$pwd" | timeout 60 secret-tool store \
+        --collection="$colecao" --label='GNOME Remote Desktop VNC password' \
+        xdg:schema "$xdg" epoptes 1; then
+        echo "gnome_vnc_session: nao consegui gravar a senha no chaveiro do GNOME (gnome-keyring rodando?)" >&5
+        rm -f "$dir/grd-settings"
+        return 1
+    fi
+    gsettings set "$schema" auth-method "'password'"
+    if [ "$mode" = viewonly ]; then
+        gsettings set "$schema" view-only true
+    else
+        gsettings set "$schema" view-only false
+    fi
+    gsettings set "$schema" enable true
+
+    "$grd" --vnc-port "$port" >"$dir/grd.log" 2>&1 &
+    gpid=$!
+    xprop_set EPOPTES_GRD_PID "$gpid"
+    # Espera ate 10 s o servidor do GNOME comecar a escutar.
+    tentativa=0
+    while [ "$tentativa" -lt 50 ] && kill -0 "$gpid" 2>/dev/null &&
+        ! ss -Hltn "sport = :$port" 2>/dev/null | grep -q .; do
+        tentativa=$((tentativa + 1))
+        sleep 0.2
+    done
+    if kill -0 "$gpid" 2>/dev/null; then
+        # Termina quando o servidor do Epoptes fecha o visualizador, quando o
+        # aluno clica em parar no indicador do GNOME, ou no stop_receptions.
+        socat "TCP:$target" "TCP:127.0.0.1:$port"
+    else
+        echo "gnome_vnc_session: o gnome-remote-desktop nao subiu, veja $dir/grd.log" >&5
+    fi
+
+    kill "$gpid" 2>/dev/null
+    wait "$gpid" 2>/dev/null
+    xprop_unset EPOPTES_GRD_PID
+    while read -r k v; do
+        gsettings set "$schema" "$k" "$v"
+    done <"$dir/grd-settings"
+    rm -f "$dir/grd-settings"
+    timeout 60 secret-tool clear xdg:schema "$xdg" epoptes 1
+}
