+    def on_font_zoom_key(self, _widget, event):
+        """Handle Ctrl +, Ctrl - and Ctrl 0 in the main window."""
+        if not event.state & Gdk.ModifierType.CONTROL_MASK:
+            return False
+        nome = Gdk.keyval_name(event.keyval)
+        if nome in ('plus', 'equal', 'KP_Add'):
+            self.mudar_fonte(1)
+        elif nome in ('minus', 'KP_Subtract'):
+            self.mudar_fonte(-1)
+        elif nome in ('0', 'KP_0', 'KP_Insert'):
+            self.mudar_fonte(0)
+        else:
+            return False
+        return True
