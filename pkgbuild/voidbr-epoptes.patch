+#!/bin/sh
+# -*- coding: utf-8 -*-
+#
+#  session-watch — VoidBR: sobe a conexao da sessao do epoptes-client quando
+#                  o ambiente grafico nao roda o autostart do XDG
+#  Created: qua 25 nov 2026 10:55:00 -04
+#  Updated: qui 26 nov 2026 22:33:04 -04
+#
+#  Copyright (c) 2026, Vilmar Catafesta <vcatafesta@gmail.com>
+#  SPDX-License-Identifier: GPL-3.0-or-later
+#
+# O epoptes-client da sessao (o que observa a tela, tira miniatura etc.) sobe
+# pelo /etc/xdg/autostart/epoptes-client.desktop. GNOME, KDE e XFCE rodam esse
+# autostart; Umbriel, Sway, Hyprland, river, labwc, i3, dwm... nao. Este vigia
+# roda como root, junto da conexao do root (o epoptes-client do servico), e a
+# cada SESSION_WATCH_INTERVAL segundos procura usuarios com sessao grafica e
+# sem conexao de sessao. Se a conexao nao aparecer em SESSION_WATCH_GRACE
+# segundos (tempo de o autostart agir, onde existe), sobe o epoptes-client
+# como o usuario, com o ambiente da sessao dele (WAYLAND_DISPLAY/DISPLAY,
+# XDG_RUNTIME_DIR, D-Bus).
+#
+# Uso: session-watch <pid>   (sai quando o processo <pid> terminar)
+# Desligar: SESSION_WATCH=false em /etc/default/epoptes-client
+
+_VERSION_="1.0.2-20261126"
+
+pai=$1
+interval=${SESSION_WATCH_INTERVAL:-10}
+grace=${SESSION_WATCH_GRACE:-30}
+state=/run/epoptes-client/session-watch
+client=/usr/sbin/epoptes-client
+test -x "$client" || client=$(command -v epoptes-client)
+
+test "$(id -u)" -eq 0 || exit 0
+test -n "$pai" || exit 0
+
+cd / || exit 0
+mkdir -p "$state" || exit 0
+# Um vigia so: o novo substitui o anterior (reinicio do servico)
+if [ -s "$state/pid" ]; then
+    kill "$(cat "$state/pid")" 2>/dev/null
+fi
+echo $$ >"$state/pid"
+
+# Apaga o arquivo do PID so se ainda for o deste vigia. No reinicio do
+# servico o vigia novo grava o PID dele e encerra este; sem a conferencia,
+# este apagava o arquivo do novo, que ficava sem poder ser encerrado no
+# reinicio seguinte (dois vigias) e o --check o dava como parado.
+apaga_pid() {
+    test "$(cat "$state/pid" 2>/dev/null)" = "$$" && rm -f "$state/pid"
+}
+trap 'apaga_pid; exit 0' INT TERM
+
+uid_min=$(awk '$1 == "UID_MIN" { print $2; exit }' /etc/login.defs 2>/dev/null)
+uid_min=${uid_min:-1000}
+
+log() {
+    echo "epoptes-client session-watch: $*" >&2
+}
+
+# Imprime "usuario pid" de um processo por usuario com sessao grafica local:
+# WAYLAND_DISPLAY ou DISPLAY=:N no ambiente, sem SSH_CONNECTION (ssh -X nao
+# e sessao da tela). Do mais antigo para o mais novo: fica o primeiro, que
+# normalmente e o proprio compositor ou a sessao.
+graphical_sessions() {
+    ps -e --sort=start_time -o uid=,user:32=,pid= |
+        while read -r uid user pid; do
+            test "$uid" -ge "$uid_min" 2>/dev/null && test "$uid" -lt 65534 || continue
+            # O 2>/dev/null vem antes do <: o processo pode ter acabado
+            # depois do ps, e no sh o erro de abrir o arquivo so e calado se o
+            # stderr ja estiver desviado.
+            env=$(tr '\0' '\n' 2>/dev/null <"/proc/$pid/environ") || continue
+            case "$env" in
+            *SSH_CONNECTION=*) continue ;;
+            esac
+            echo "$env" | grep -Eq '^(WAYLAND_DISPLAY=.|DISPLAY=:)' || continue
+            echo "$user $pid"
+        done | awk '!visto[$1]++'
+}
+
+# A sessao do usuario ja tem conexao? Cada conexao e um processo socat que
+# fala com o servidor do Epoptes (openssl-connect:SERVER:PORT,... ou
+# tcp:SERVER:PORT,...). So o socat que vai para SERVER:PORT conta: um socat
+# qualquer do usuario, alheio ao Epoptes, nao. SERVER e PORT vem exportados
+# do epoptes-client que sobe o vigia.
+has_session_conn() {
+    ps -C socat -o user:32=,args= 2>/dev/null |
+        awk -v u="$1" -v alvo=":${SERVER:-server}:${PORT:-789}," '
+            $1 == u && index($0, alvo) { achou = 1 }
+            END { exit !achou }'
+}
+
+# Valor de uma variavel no ambiente do processo $1
+env_of() {
+    tr '\0' '\n' 2>/dev/null <"/proc/$1/environ" | sed -n "s/^$2=//p" | head -n 1
+}
+
+launch() {
+    local_user=$1
+    local_pid=$2
+    wd=$(env_of "$local_pid" WAYLAND_DISPLAY)
+    dp=$(env_of "$local_pid" DISPLAY)
+    rt=$(env_of "$local_pid" XDG_RUNTIME_DIR)
+    test -n "$rt" || rt=/run/user/$(id -u "$local_user")
+    # Ambiente de outra sessao que ja acabou (socket sumiu): nao sobe nada
+    if [ -n "$wd" ]; then
+        case "$wd" in
+        /*) test -S "$wd" ;;
+        *) test -S "$rt/$wd" ;;
+        esac || return 0
+    elif [ -n "$dp" ]; then
+        n=${dp#:}
+        n=${n%%.*}
+        test -S "/tmp/.X11-unix/X$n" || return 0
+    fi
+    home=$(getent passwd "$local_user" | cut -d: -f6)
+    log "sessao grafica de $local_user sem conexao: iniciando o epoptes-client da sessao"
+    # O ambiente vai em "$@", um item por variavel: um valor com espaco (um
+    # XAUTHORITY em pasta com espaco, por exemplo) nao se parte em dois.
+    set -- HOME="$home" USER="$local_user" LOGNAME="$local_user" \
+        SHELL="$(getent passwd "$local_user" | cut -d: -f7)" \
+        PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin" \
+        XDG_RUNTIME_DIR="$rt"
+    for v in WAYLAND_DISPLAY DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS \
+        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
+        XDG_SESSION_ID DESKTOP_SESSION LANG LANGUAGE LC_ALL; do
+        val=$(env_of "$local_pid" "$v")
+        test -n "$val" && set -- "$@" "$v=$val"
+    done
+    setsid -f setpriv --reuid="$(id -u "$local_user")" --regid="$(id -g "$local_user")" --init-groups \
+        env -i "$@" "$client" </dev/null >/dev/null 2>&1
+}
+
+while kill -0 "$pai" 2>/dev/null; do
+    agora=$(date +%s)
+    vistos=""
+    for linha in $(graphical_sessions | tr ' ' ':'); do
+        user=${linha%%:*}
+        pid=${linha#*:}
+        vistos="$vistos $user"
+        if has_session_conn "$user"; then
+            rm -f "$state/$user"
+            continue
+        fi
+        # Primeira vez sem conexao: marca e espera o autostart (se existir)
+        if ! [ -s "$state/$user" ]; then
+            echo "$agora" >"$state/$user"
+            continue
+        fi
+        desde=$(cat "$state/$user")
+        if [ $((agora - desde)) -ge "$grace" ]; then
+            launch "$user" "$pid"
+            # Conta de novo: se ainda nao conectar, tenta outra vez depois
+            echo "$agora" >"$state/$user"
+        fi
+    done
+    # Quem saiu da sessao grafica perde a marca
+    for f in "$state"/*; do
+        u=${f##*/}
+        test "$u" = pid && continue
+        test -e "$f" || continue
+        case " $vistos " in
+        *" $u "*) ;;
+        *) rm -f "$f" ;;
+        esac
+    done
+    sleep "$interval"
+done
+apaga_pid
