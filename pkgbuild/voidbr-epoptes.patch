+    def zoom_imagem_tema(self, img, escala):
+        """Resize a stock or named icon; keep its original for 100%."""
+        orig = self.img_tema.get(img)
+        if orig is None:
+            tipo = img.get_storage_type()
+            if tipo == Gtk.ImageType.STOCK:
+                orig = ('stock',) + tuple(img.get_stock())
+            elif tipo == Gtk.ImageType.ICON_NAME:
+                orig = ('icon',) + tuple(img.get_icon_name())
+            else:
+                return
+            if escala == 1.0:
+                return
+            self.img_tema[img] = orig
+            img.connect('destroy', lambda w: self.img_tema.pop(w, None))
+        tipo, nome, tamanho = orig
+        if escala == 1.0:
+            img.set_pixel_size(-1)
+            if tipo == 'stock':
+                img.set_from_stock(nome, tamanho)
+            return
+        _ok, largura, _a = Gtk.icon_size_lookup(tamanho)
+        pixels = round(largura * escala)
+        if tipo == 'stock':
+            # O pixel_size nao vale para icone "stock" no GTK3: troca pelo
+            # nome equivalente no tema ou, sem ele, reduz o stock grande.
+            tema = {'gtk-add': 'list-add', 'gtk-remove': 'list-remove',
+                    'gtk-go-up': 'go-up', 'gtk-go-down': 'go-down',
+                    'gtk-zoom-in': 'zoom-in', 'gtk-zoom-out': 'zoom-out',
+                    'gtk-missing-image': 'image-missing',
+                    'gtk-dialog-warning': 'dialog-warning',
+                    'gtk-media-play': 'media-playback-start',
+                    'gtk-network': 'network-workgroup',
+                    'gtk-edit': 'document-edit', 'gtk-execute': 'system-run',
+                    'gtk-go-forward': 'go-next'}.get(nome, nome)
