+    def row_name(self, row):
+        """Return e.g. "lab-05 (maria)" for an iconview entry."""
+        client, hsession = row[C_INSTANCE], row[C_SESSION_HANDLE]
+        user = client.users.get(hsession, {}).get('uname', '') \
+            if hsession else ''
