+# VoidBR patch: chama o PermissionStore do portal ($1 = metodo, o resto vai
+# como argumentos do dbus-send).
+kde_permission_store() {
+    local metodo="$1"
+
+    shift
+    dbus-send --session --print-reply \
+        --dest=org.freedesktop.impl.portal.PermissionStore \
+        /org/freedesktop/impl/portal/PermissionStore \
+        "org.freedesktop.impl.portal.PermissionStore.$metodo" "$@" 2>/dev/null
+}
