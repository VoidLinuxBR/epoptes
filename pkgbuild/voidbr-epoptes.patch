+    def session_position(self, client, hsession):
+        """Return (position, total) of a session among the user's sessions,
+        in connection order (the oldest first)."""
+        uname = client.users.get(hsession, {}).get('uname', '')
+        same = [h for h, u in client.users.items() if u['uname'] == uname]
+        return same.index(hsession) + 1, len(same)
