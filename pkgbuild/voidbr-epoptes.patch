+def need_relogin():
+    """VoidBR/Chili patch: o usuario ja esta no grupo do socket em
+    /etc/group, mas a sessao atual comecou antes disso (os grupos de um
+    processo sao definidos no login) e o sg nao resolveu - no Arch nem
+    existe /usr/bin/sg. Sem este aviso, epoptes_socket() nao enxerga o
+    socket dentro de /run/epoptes (2770 root:epoptes), cai no tunel SSH
+    para o host "server" e falha com um erro confuso."""
+    if not os.path.isdir(config.system['DIR']):
+        return False
+    socket = config.system['DIR'] + '/epoptes.socket'
+    if os.access(socket, os.W_OK):
+        return False
+    try:
+        group = grp.getgrnam(config.system['SOCKET_GROUP'])
+    except KeyError:
+        return False
+    if getpass.getuser() not in group.gr_mem:
+        return False
+    if group.gr_gid in os.getgroups():
+        return False
+    return True
+
+
+def relogin_dialog():
+    """VoidBR/Chili patch: explica que e preciso iniciar uma sessao nova."""
+    group = config.system['SOCKET_GROUP']
+    msg = ("O usuário <b>%s</b> já está no grupo <b>%s</b>, mas esta "
+           "sessão foi iniciada antes disso e ainda não tem o grupo.\n\n"
+           "Encerre a sessão e entre novamente para usar o Epoptes. "
+           "Se isso não bastar (no GNOME e em outros ambientes com systemd, "
+           "a sessão pode reaproveitar os grupos antigos), reinicie o "
+           "computador.\n\n"
+           "Para usar agora sem sair, rode num terminal:\n"
+           "<tt>newgrp %s</tt>\n<tt>epoptes &amp;</tt>") % \
+        (getpass.getuser(), group, group)
+    LOG.w("User is in group %s but this session doesn't have it yet; "
+          "log out and back in (or reboot, if the session reuses the old "
+          "groups), or run: newgrp %s" % (group, group))
+    dlg = Gtk.MessageDialog(type=Gtk.MessageType.WARNING,
+                            buttons=Gtk.ButtonsType.OK)
+    dlg.set_markup(msg)
+    dlg.set_title('Epoptes')
+    dlg.run()
+    dlg.destroy()
+
+
