+server_fingerprint() {
+    timeout 5 openssl s_client -connect "$SERVER:$PORT" </dev/null 2>/dev/null |
+        sed '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/!d' |
+        openssl x509 -noout -fingerprint -sha256 2>/dev/null
+}
+
+local_fingerprint() {
+    openssl x509 -noout -fingerprint -sha256 -in "$servercrt" 2>/dev/null
+}
+
+# VoidBR patch: quando o servidor e reinstalado ele gera um certificado novo,
+# e o cliente com o antigo so falha no TLS, em silencio, para sempre. Avisa
+# no log (svlogd/journal do root, ~/.xsession-errors da sessao) como resolver.
+check_certificate() {
+    local remote
+
+    remote=$(server_fingerprint)
+    test -n "$remote" || return 0
+    if [ "$remote" != "$(local_fingerprint)" ]; then
+        echo "epoptes-client WARNING: the certificate of $SERVER:$PORT changed" \
+            "(server reinstalled?). Run as root: epoptes-client -c," \
+            "then restart the epoptes-client service and the session." >&2
+    fi
+}
+
+# Cores so quando a saida e um terminal (em pipe/arquivo, texto puro).
+check_colors() {
+    if [ -t 1 ]; then
+        red=$(printf '\033[1;31m')
+        green=$(printf '\033[1;32m')
+        yellow=$(printf '\033[1;33m')
+        blue=$(printf '\033[1;34m')
+        bold=$(printf '\033[1m')
+        reset=$(printf '\033[0m')
+    else
+        red= green= yellow= blue= bold= reset=
+    fi
+}
+
+check_ok() {
+    echo "  ${green}[OK]${reset}    $*"
+}
+
+check_info() {
+    echo "  ${blue}[INFO]${reset}  $*"
+}
+
+check_fail() {
+    echo "  ${red}[FALHA]${reset} $1"
+    test -n "$2" && echo "          ${yellow}-> $2${reset}"
+    check_failures=$((check_failures + 1))
+}
+
+# Estado do servico do root no runit: "run", "down", "finish" ou vazio. O
+# sv status precisa de root (supervise/ok); como usuario, deduz pelos
+# processos: o runsv do servico e o socat do root.
+runit_service_state() {
+    local st
+
+    st=$(sv status /etc/sv/epoptes-client 2>/dev/null)
+    case "$st" in
+    run:* | down:* | finish:*)
+        echo "$st" | sed 's/^\([a-z]*\): [^:]*: \([^;]*\).*/\1 \2/'
+        return
+        ;;
+    esac
+    if ! ps -C runsv -o args= | grep -qx 'runsv epoptes-client'; then
+        echo "nosupervise"
+    elif ps -C socat -o user= | grep -qx root; then
+        echo "run (deduzido pelos processos; use sudo para o estado exato)"
+    else
+        echo "down (deduzido pelos processos; use sudo para o estado exato)"
+    fi
+}
+
+# VoidBR patch: epoptes-client --check, diagnostico em uma saida so.
+# VoidBR patch: usuarios com sessao grafica aberta nesta maquina, um por
+# linha. Mesmo criterio do graphical_users() do client-functions (o selo
+# "Sessao nao conectou" do servidor) e do vigia: um processo de uid comum com
+# WAYLAND_DISPLAY ou DISPLAY=:N no ambiente e o socket dessa tela ainda
+# existindo. So o root le o ambiente de todos.
+graphical_session_users() {
+    local uid_min f pid uid vistos amb wd dp rt n
+
+    uid_min=$(awk '$1 == "UID_MIN" { print $2; exit }' /etc/login.defs 2>/dev/null)
+    uid_min=${uid_min:-1000}
+    vistos=" "
+    for f in $(grep -lsa 'DISPLAY=' /proc/[0-9]*/environ 2>/dev/null); do
+        pid=${f#/proc/}
+        pid=${pid%/environ}
+        uid=$(stat -c %u "/proc/$pid" 2>/dev/null) || continue
+        test "$uid" -ge "$uid_min" 2>/dev/null && test "$uid" -lt 65534 || continue
+        case "$vistos" in
+        *" $uid "*) continue ;;
+        esac
+        amb=$(tr '\0' '\n' 2>/dev/null <"$f") || continue
+        wd=$(echo "$amb" | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1)
+        dp=$(echo "$amb" | sed -n 's/^DISPLAY=//p' | head -n 1)
+        rt=$(echo "$amb" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n 1)
+        rt=${rt:-/run/user/$uid}
+        # O socket da tela tem que existir: um processo que sobrou de uma
+        # sessao que ja acabou (ou um ssh -X, DISPLAY=localhost:10) nao conta.
+        if [ -n "$wd" ]; then
+            case "$wd" in
+            /*) test -S "$wd" ;;
+            *) test -S "$rt/$wd" ;;
+            esac || continue
+        else
+            case "$dp" in
+            :*) ;;
+            *) continue ;;
+            esac
+            n=${dp#:}
+            n=${n%%.*}
+            test -S "/tmp/.X11-unix/X$n" || continue
+        fi
+        vistos="$vistos$uid "
+        stat -c %U "/proc/$pid" 2>/dev/null
+    done | sort -u
+}
+
+run_check() {
+    local dir missing f remote conns err me procs summary mypids mycount state
+    local sessoes u upids
+
+    check_failures=0
+    dir=/usr/share/epoptes-client
+    check_colors
+    echo "${bold}Diagnostico do epoptes-client${reset} (servidor $SERVER:$PORT, uid $UID)"
+
+    missing=
+    for f in _common.py endsession get-display lock.svg lock_screen.py \
+        message.py receive-terminals remote_assistance.py \
+        remote_assistance.ui share-terminal thumbshot.py; do
+        test -e "$dir/$f" || missing="$missing $f"
+    done
+    if [ -z "$missing" ]; then
+        check_ok "arquivos de $dir completos"
+    else
+        check_fail "faltam arquivos em $dir:$missing" \
+            "reinstale o pacote do cliente (xbps-install -f / pacman -S)"
+    fi
+
+    # O processo do root vem do servico. Ele pode estar rodando desde o boot
+    # e mesmo assim estar desabilitado - ai nao volta no proximo boot.
+    if [ -d /run/systemd/system ]; then
+        if systemctl is-enabled --quiet epoptes-client 2>/dev/null; then
+            check_ok "servico epoptes-client habilitado no boot (systemd)"
+        else
+            check_fail "servico epoptes-client nao esta habilitado no boot" \
+                "sudo systemctl enable --now epoptes-client"
+        fi
+        state=$(systemctl is-active epoptes-client 2>/dev/null)
+        if [ "$state" = active ]; then
+            check_ok "servico epoptes-client rodando (systemd: active)"
+        else
+            check_fail "servico epoptes-client nao esta rodando (systemd: ${state:-?})" \
+                "sudo systemctl start epoptes-client"
+        fi
+    elif [ -d /etc/runit/runsvdir ]; then
+        if [ -e /etc/runit/runsvdir/current/epoptes-client ]; then
+            check_ok "servico epoptes-client habilitado no boot (runit)"
+        else
+            check_fail "servico epoptes-client nao esta habilitado no boot" \
+                "sudo ln -s /etc/sv/epoptes-client /var/service/"
+        fi
+        state=$(runit_service_state)
+        case "$state" in
+        run*)
+            check_ok "servico epoptes-client rodando (runit: $state)"
+            ;;
+        down*)
+            check_fail "servico epoptes-client parado (runit: $state)" \
+                "sudo sv up epoptes-client"
+            ;;
+        finish*)
+            check_fail "servico epoptes-client encerrando/reiniciando (runit: $state)" \
+                "aguarde alguns segundos e rode o --check de novo"
+            ;;
+        *)
+            check_fail "servico epoptes-client sem supervisao do runit (nenhum runsv)" \
+                "habilite o servico; se ja esta habilitado, aguarde 5 s ou reinicie"
+            ;;
+        esac
+    fi
+
+    if [ -z "$(echo "$SERVER" | tr -d '0-9.')" ] ||
+        getent hosts "$SERVER" >/dev/null; then
+        check_ok "o nome $SERVER resolve: $(getent hosts "$SERVER" | awk '{ print $1; exit }')"
+    else
+        check_fail "o nome $SERVER nao resolve" \
+            "ajuste SERVER= em /etc/default/epoptes-client ou o /etc/hosts"
+    fi
+
+    if [ -s "$servercrt" ]; then
+        check_ok "certificado local em $servercrt"
+    else
+        check_fail "nao existe $servercrt" "rode como root: epoptes-client -c"
+    fi
+
+    remote=$(server_fingerprint)
+    if [ -z "$remote" ]; then
+        check_fail "nao conectou em $SERVER:$PORT" \
+            "servidor desligado, servico epoptes parado, firewall ou rede/VPN"
+    elif [ "$remote" != "$(local_fingerprint)" ]; then
+        check_fail "o certificado do servidor e diferente do local" \
+            "rode como root: epoptes-client -c, e reinicie o servico e a sessao"
+    else
+        check_ok "o servidor responde e o certificado confere"
+    fi
+
+    # Cada conexao do epoptes-client e um processo socat. Ele existe mesmo
+    # enquanto ainda tenta conectar (tenta de novo a cada 60 s), por isso
+    # conta os processos, e nao so as conexoes ja estabelecidas.
+    me=$(id -un)
+    procs=$(ps --sort=start_time -C socat -o user:32=,pid=,args= |
+        grep "openssl-connect:$SERVER:$PORT")
+    summary=$(echo "$procs" | awk 'NF { c[$1]++ }
+        END { for (u in c) printf "%s(%d) ", u, c[u] }')
+    conns=$(ss -Htn state established "( dport = :$PORT )" 2>/dev/null | wc -l)
+    check_info "processos por usuario: ${summary:-nenhum}; conexoes estabelecidas: $conns"
+    # Do mais antigo para o mais novo (--sort=start_time); o primeiro e o que
+    # fica - normalmente o do login, que sobe antes de qualquer um aberto a
+    # mao. (Nao da para usar o terminal para separar: no Void os processos da
+    # sessao grafica herdam o tty do Xorg, como o tty8.)
+    mypids=$(echo "$procs" | awk -v u="$me" '$1 == u { print $2 }')
+    mycount=$(echo "$mypids" | grep -c .)
+    if [ "$mycount" -eq 0 ]; then
+        if [ "$UID" -eq 0 ]; then
+            check_fail "nenhum processo epoptes-client do root" \
+                "reinicie o servico epoptes-client"
+        else
+            check_fail "nenhum processo epoptes-client da sua sessao ($me)" \
+                "encerre a sessao e entre de novo, ou rode: setsid -f epoptes-client"
+        fi
+    elif [ "$mycount" -gt 1 ]; then
+        # Encerra o shell filho de cada socat extra com KILL: com kill comum
+        # (TERM), ou matando o proprio socat, o shell se reinicia sozinho
+        # (trap 0 15 no client-functions); e o QUIT e ignorado pelos que
+        # nasceram desse reinicio, que roda em segundo plano.
+        check_fail "$mycount processos epoptes-client de $me (duplicados)" \
+            "mantenha o PID $(echo "$mypids" | head -n 1) e encerre os outros: $(echo "$mypids" | tail -n +2 | sed 's/^/pkill -KILL -P /' | paste -sd ';' | sed 's/;/; /g')"
+    else
+        # ss -p so mostra o PID dos proprios processos, o que basta aqui.
+        if ss -Htnp state established "( dport = :$PORT )" 2>/dev/null |
+            grep -q "pid=$mypids,"; then
+            check_ok "a conexao de $me esta estabelecida (PID $mypids)"
+        else
+            check_fail "o processo de $me (PID $mypids) ainda nao conectou" \
+                "ele tenta de novo a cada 60 s; aguarde e rode o --check de novo"
+        fi
+    fi
+
+    if [ "$UID" -eq 0 ]; then
+        if my_boolean_is_true "${SESSION_WATCH:-true}"; then
+            if [ -s /run/epoptes-client/session-watch/pid ] &&
+                kill -0 "$(cat /run/epoptes-client/session-watch/pid)" 2>/dev/null; then
+                check_ok "vigia de sessoes ativo (sobe a conexao da sessao em Umbriel, Sway, Hyprland...)"
+            else
+                check_info "vigia de sessoes nao esta rodando (reinicie o servico epoptes-client)"
+            fi
+        else
+            check_info "vigia de sessoes desligado (SESSION_WATCH=false)"
+        fi
+        # Cada sessao grafica aberta precisa da sua conexao (a do
+        # epoptes-client.desktop do autostart ou a que o vigia sobe); sem ela
+        # o servidor nao ve o usuario, nem faz miniatura ou Observar.
+        sessoes=$(graphical_session_users)
+        if [ -z "$sessoes" ]; then
+            check_info "nenhum usuario com sessao grafica aberta (tela de login?): so a conexao do root"
+        fi
+        for u in $sessoes; do
+            upids=$(echo "$procs" | awk -v u="$u" '$1 == u { print $2 }')
+            if [ -z "$upids" ]; then
+                if my_boolean_is_true "${SESSION_WATCH:-true}"; then
+                    check_fail "sessao grafica de $u sem conexao: o epoptes-client da sessao nao foi iniciado" \
+                        "o vigia sobe a conexao em ate uns 40 s depois do login; se nao subir, veja o grupo epoptes, o autostart (epoptes-client.desktop) e o certificado, e rode o --check como $u, na sessao grafica"
+                else
+                    check_fail "sessao grafica de $u sem conexao: o epoptes-client da sessao nao foi iniciado" \
+                        "vigia desligado (SESSION_WATCH=false) e o autostart (epoptes-client.desktop) nao rodou; veja tambem o grupo epoptes e o certificado; como $u, na sessao grafica: setsid -f epoptes-client"
+                fi
+            elif ss -Htnp state established "( dport = :$PORT )" 2>/dev/null |
+                grep -Eq "pid=($(echo "$upids" | paste -sd '|')),"; then
+                check_ok "sessao grafica de $u conectada (PID $(echo "$upids" | paste -sd ' '))"
+            else
+                check_fail "sessao grafica de $u: o epoptes-client da sessao ainda nao conectou" \
+                    "ele tenta de novo a cada 60 s; aguarde e rode o --check de novo"
+            fi
+        done
+        check_info "rode tambem como usuario, na sessao grafica, para testar a miniatura"
+    elif [ -n "$WAYLAND_DISPLAY" ] || [ -n "$DISPLAY" ]; then
+        if err=$(cd "$dir" && ./thumbshot.py 16 12 2>&1 >/dev/null); then
+            check_ok "miniatura (thumbshot) funciona nesta sessao"
+        else
+            check_fail "miniatura (thumbshot) falhou" \
+                "$(echo "$err" | tail -n 1)"
+        fi
+    else
+        check_info "sem sessao grafica (DISPLAY/WAYLAND_DISPLAY): miniatura nao testada"
+    fi
+
+    if [ "$check_failures" -eq 0 ]; then
+        echo "${green}${bold}Tudo certo.${reset}"
+    else
+        echo "${red}${bold}$check_failures problema(s) encontrado(s).${reset}"
+    fi
+    exit "$check_failures"
+}
