+        uinfo = self.conn_info.get(hsession, {}) if hsession else {}
+        info = uinfo or sysinfo
+        lines = ['<b>%s</b>' % esc(client.get_name())]
+        details = []
+        if info.get('ip'):
+            details.append('IP ' + info['ip'])
+        if client.mac:
+            details.append('MAC ' + client.mac)
+        if details:
+            lines.append(esc(' \u00b7 '.join(details)))
+        if info.get('version'):
+            lines.append(esc('Cliente epoptes %s' % info['version']))
+        lines.append('Conex\u00e3o do root: ' + (
+            'conectada' if client.hsystem else 'ausente'))
+        if hsession:
+            uname = client.users.get(hsession, {}).get('uname', '')
+            desc = self.session_desc(uinfo)
+            lines.append(esc('Sess\u00e3o: %s%s' % (
+                uname, ' (%s)' % desc if desc else '')))
+            pos, total = self.session_position(client, hsession)
