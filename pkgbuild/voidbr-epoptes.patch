+reconnect() {
+    if [ "$UID" -eq 0 ]; then
+        echo "reconnect: so na conexao da sessao" >&5
+        return 0
+    fi
+    trap - 0 15
+    if [ "$1" != drop ]; then
+        echo "epoptes-client: reconectando a pedido do servidor" >&5
+        # Espera este shell morrer, para o epoptes-client novo nao ver a
+        # conexao antiga. O setsid desliga o novo deste shell.
