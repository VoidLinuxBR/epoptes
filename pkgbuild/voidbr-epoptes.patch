+    # abre em modo so de ver; o krfb nao tem esse modo sem desligar o inicio
+    # automatico do compartilhamento.
+    rm -rf "$cfgdir"
+    mkdir -p "$cfgdir"
+    if ! python3 - "$pwd" "$port" "$cfgdir/krfbrc" <<'EOF'
+import sys
+senha, porta, arquivo = sys.argv[1:4]
+obscura = "".join(c if ord(c) <= 0x21 else chr(0x1001F - ord(c)) for c in senha)
+with open(arquivo, "w", encoding="utf-8") as f:
+    f.write("[MainWindow]\nstartMinimized=true\n\n"
+            "[TCP]\nuseDefaultPort=false\nport=%s\npublishService=false\n\n"
+            "[Security]\nnoWallet=true\nallowDesktopControl=true\n"
+            "allowUnattendedAccess=true\nunattendedPassword=%s\n\n"
+            "[FrameBuffer]\npreferredFrameBufferPlugin=pw\n" % (porta, obscura))
