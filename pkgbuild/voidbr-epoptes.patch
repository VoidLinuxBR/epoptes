+    def aplicar_fonte(self):
+        """Apply self.escala_fonte to all the epoptes windows."""
+        nome = Gtk.Settings.get_default().props.gtk_font_name or ''
+        achou = re.search(r'(\d+(?:\.\d+)?)\s*$', nome)
+        base = float(achou.group(1)) if achou else 11.0
+        escala = self.escala_fonte
+        # "*" e nao "window *": no GTK3 o no CSS dos dialogos e "dialog"
+        # (e "messagedialog"/"aboutdialog"), que "window" nao alcanca.
+        self.css_fonte.load_from_data((
+            '* { font-size: %.1fpt; }\n' % (base * escala)).encode('utf-8'))
+        self.aplicar_icones(escala)
+        for janela in Gtk.Window.list_toplevels():
+            janela.queue_resize()
+        self.mi_normal.get_child().set_text_with_mnemonic(
+            'Tamanho _normal (agora %d%%)' % round(escala * 100))
+        self.mi_menor.set_sensitive(escala > ESCALA_MIN + 0.001)
+        self.mi_maior.set_sensitive(escala < ESCALA_MAX - 0.001)
