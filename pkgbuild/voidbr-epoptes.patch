+    def observe_unsupported(self, row):
+        """Return why Observe/Assist can't work on an entry, or ''."""
+        hsession = row[C_SESSION_HANDLE]
+        if not hsession:
+            return ''
+        info = self.conn_info.get(hsession, {})
+        session = info.get('session', '')
+        desktop = info.get('desktop', '').upper()
+        # Sem o campo vnc= (servidor antigo), nao da para saber
+        vnc = info.get('vnc')
+        vnc = vnc.split(',') if vnc is not None else None
+        if session == 'wayland':
+            if 'KDE' in desktop or 'PLASMA' in desktop:
+                if vnc is not None and 'krfb' not in vnc:
+                    return ('falta o pacote krfb no cliente (o servidor VNC '
+                            'do KDE, com o patch do VoidBR)')
+                return ''
+            if 'GNOME' in desktop:
+                if vnc is not None and 'grd' not in vnc:
+                    return ('falta o pacote gnome-remote-desktop no cliente '
+                            '(o servidor VNC do pr\u00f3prio GNOME) ou o '
+                            'secret-tool (pacote libsecret)')
+                return ''
+            if vnc is not None and 'wayvnc' not in vnc:
+                return 'falta o pacote wayvnc no cliente'
+        elif session == 'x11' and vnc is not None and 'x11vnc' not in vnc:
