+# VoidBR patch: encerra o Observar/Assistir do GNOME em andamento. Basta
+# encerrar o servidor do GNOME: o socat termina junto e o gnome_vnc_session
+# devolve a configuracao e a senha do usuario.
+gnome_vnc_stop() {
+    local pid
+
+    pid=$(xprop_get EPOPTES_GRD_PID)
+    if [ -n "$pid" ] && kill "$pid" 2>/dev/null; then
+        sleep 1
+    fi
